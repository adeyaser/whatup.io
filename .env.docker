# Environment untuk Docker Compose
# Copy ke .env.docker dan sesuaikan nilai-nilainya

# Application
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database
DB_HOST=mysql
DB_USER=wa_gateway_user
DB_PASSWORD=secure-password-change-this
DB_NAME=wa_gateway
DB_PORT=3306

MYSQL_ROOT_PASSWORD=root-secure-password-change-this

# JWT
JWT_SECRET=your-secret-key-min-32-characters-change-this
JWT_EXPIRE=24h

# Application
NODE_ENV=production
PORT=3001
